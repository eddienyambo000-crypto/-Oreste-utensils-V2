{
  "id": "/admin",
  "name": "Oreste Admin",
  "short_name": "Oreste Admin",
  "description": "Add products and manage orders for Oreste Utensils.",
  "start_url": "/admin",
  "scope": "/admin",
  "display": "standalone",
  "background_color": "#faf6f0",
  "theme_color": "#211c15",
  "icons": [
    { "src": "/icons/admin-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/admin-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/admin-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Add a product",
      "short_name": "Add product",
      "url": "/admin/products/new",
      "icons": [{ "src": "/icons/admin-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Products",
      "url": "/admin/products",
      "icons": [{ "src": "/icons/admin-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Orders",
      "url": "/admin/orders",
      "icons": [{ "src": "/icons/admin-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
