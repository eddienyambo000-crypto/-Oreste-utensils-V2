# ── Site ──────────────────────────────────────────────────────────────
# Canonical, absolute URL of the deployed site (used for metadata, sitemap,
# JSON-LD and OG tags). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://oresteutensils.com

# ── Supabase ──────────────────────────────────────────────────────────
# From Supabase → Project Settings → API.
# The site runs on seed data when these are absent, so you can develop the
# storefront with none of them set. All three are required for the admin
# panel and live orders.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY — never exposed to the browser. Used by the order API to record
# orders past RLS. Keep this secret; rotate it if it ever leaks.
SUPABASE_SERVICE_ROLE_KEY=
